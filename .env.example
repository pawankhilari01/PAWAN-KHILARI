# EDT Platform configuration — copy to .env and fill in. Secrets come from Vault in prod.

# --- LLM (Anthropic Claude) ---
EDT_LLM_ANTHROPIC_API_KEY=
EDT_LLM_DEFAULT_TIER=claude-sonnet-5
EDT_LLM_MAX_OUTPUT_TOKENS=8192
EDT_LLM_ENABLE_PROMPT_CACHING=true
EDT_LLM_ENABLE_EXTENDED_THINKING=true

# --- Stores ---
EDT_STORE_POSTGRES_DSN=postgresql+asyncpg://edt:edt@localhost:5432/edt
EDT_STORE_REDIS_URL=redis://localhost:6379/0
EDT_STORE_QDRANT_URL=http://localhost:6333
EDT_STORE_NEO4J_URI=bolt://localhost:7687
EDT_STORE_NEO4J_USER=neo4j
EDT_STORE_NEO4J_PASSWORD=edtneo4j
EDT_STORE_S3_ENDPOINT=http://localhost:9000
EDT_STORE_S3_BUCKET=edt-artifacts

# --- Events ---
EDT_EVENT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EDT_EVENT_SCHEMA_REGISTRY_URL=http://localhost:8081

# --- RAG ---
EDT_RAG_EMBEDDING_MODEL=voyage-3
EDT_RAG_RERANK_MODEL=rerank-2
EDT_RAG_ENABLE_GRAPH_RAG=true

# --- Governance ---
EDT_GOV_REQUIRE_PHASE_APPROVAL=true
EDT_GOV_DEFAULT_CONFIDENCE_THRESHOLD=0.72
EDT_GOV_PER_RUN_USD_BUDGET=250
EDT_GOV_OIDC_ISSUER=https://keycloak.internal/realms/edt

# --- Observability ---
EDT_OBS_OTLP_ENDPOINT=http://localhost:4317
EDT_OBS_ENVIRONMENT=dev
EDT_OBS_LOG_LEVEL=INFO
